# Create your own Discord application/bot and keep the token only in local .env.
DISCORD_BOT_TOKEN=replace_with_your_bot_token
# Optional: a development server ID for immediate guild command registration.
DISCORD_GUILD_ID=
PORTLE_TIMEZONE=UTC
PORTLE_CLUE_SOURCE=manual
# Optional screenshot library location; default is data/clues/.
# PORTLE_CLUES=/absolute/path/to/clues
# Optional answer-list path in manual mode (the bundled names list is the default).
# In explicit generated mode this points to the imported geometry catalog instead.
# PORTLE_CATALOG=/absolute/path/to/map_names.json
# PORTLE_DATABASE=/absolute/path/to/portle.sqlite3
